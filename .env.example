# 默认离线演示。真实模式：FAI_MODE=live，或 serve --mode live
FAI_MODE=mock
FAI_PORT=18761
FAI_DATA_DIR=./data
# 安装根目录或包含 Interface 与 WTF 的版本目录均可
WOW_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 也支持 gpt-6.1-sol。外部资料仅在点击同步/查询时获取。
FAI_REFERENCE_ENABLED=true
FAI_AUTO_SYNC=true

# auto 优先现有 OpenAI API 配置，否则复用已登录的本机 Codex。
FAI_AI_PROVIDER=auto
# 可选：Codex CLI 的可执行文件路径；留空自动发现。
FAI_CODEX_COMMAND=
